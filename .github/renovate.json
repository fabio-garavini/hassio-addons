{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["main"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": false,
  "commitMessagePrefix": "⬆️",
  "commitMessageTopic": "{{depName}}",
  "gitAuthor": "Fabio Garavini <info@fabiogaravini.dev>",
  "enabledManagers": ["custom.regex", "github-actions"],
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Add-on versions",
      "managerFilePatterns": ["/(^|/)addon_info\\.ya?ml$/"],
      "matchStrings": [
        "source:\\s*type:\\s(?<datasource>.*?)\\s*(?:registry:\\s(?<registryUrl>\\S+))?\\s*(?:repo|image):\\s(?<depName>.*?)\\s*current_version:\\s(?<currentValue>.*?)(?:\\s*version_template:\\s[\"']?(?<versioning>.*?)[\"']?)?\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update _VERSION variables in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)(?:\\sdepName=(?<depName>\\S+))?(?:\\spackageName=(?<packageName>\\S+))?(?:\\sversioning=(?<versioning>\\S+))?(?:\\sregistryUrl=(?<registryUrl>\\S+))?\\s(?:ARG|ENV)\\s.+?_VERSION\\s*=\\s*(\"|')?(?<currentValue>.+)(\"|')?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "*/addon_info.yaml",
        "*/Dockerfile"
      ],
      "postUpgradeTasks": {
        "commands": [
          "/usr/local/sbin/install-tool node latest",
          "/usr/local/sbin/install-tool npm latest",
          "node .github/scripts/addon-update.js {{packageFileDir}}"
        ],
        "fileFilters": [
          "*/config.yaml",
          "*/build.yaml",
          "*/CHANGELOG.md",
          "*/addon_info.yaml",
          "*/Dockerfile"
        ],
        "executionMode": "update"
      }
    }
  ]
}
