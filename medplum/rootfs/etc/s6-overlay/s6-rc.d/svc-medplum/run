#!/command/with-contenv bash
# shellcheck shell=bash

set -Eeuo pipefail

export MEDPLUM_SIGNING_KEY="$(cat /config/medplum/signing-key.pem)"
export MEDPLUM_SIGNING_KEY_PASSPHRASE="$(cat /config/medplum/signing-key.pass)"

echo "[svc-medplum] Starting Medplum server..."
cd /usr/src/medplum
exec s6-setuidgid node node \
    --experimental-loader=@opentelemetry/instrumentation/hook.mjs \
    --import ./packages/server/dist/otel/instrumentation.js \
    packages/server/dist/index.js env
